# Copy these into your hosting provider's environment variables (never commit real values).

# Google AI Studio key — powers the mural generation (aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Any long random string — signs the usage-quota cookie. Generate one at https://generate-secret.vercel.app/32
APP_SECRET=

# Invite codes as code:allowance pairs, comma-separated. Hand these to clients/friends.
# Example: laila gets 50 mockups, studio gets 200.
INVITE_CODES=laila:50,studio:200
